# Copy to .env (gitignored) and fill in. This file documents the ONLY key the
# repo tooling reads from .env -- do not accumulate unrelated secrets here.
#
# Weights & Biases API key, used by `w8-biayn launch glm47-full` and the SLIME
# lane wrappers for run/eval/pipeline logging. Resolution order (cloud_launch
# resolve_wandb_api_key): --wandb-api-key flag > --wandb-api-key-file >
# WANDB_API_KEY env > WANDB_KEY env > this file (WANDB_API_KEY= or WANDB_KEY=).
# The value is never printed or logged.
WANDB_KEY=

# NOT read from .env -- listed to say where they actually live:
# - GCP credentials: .gcp-service-account.json at the repo root (gitignored),
#   used via scoped env vars; never `gcloud auth activate-service-account`.
# - Hugging Face token (optional, public GLM works without): HF_TOKEN
#   environment variable or `--hf-token-file`.
