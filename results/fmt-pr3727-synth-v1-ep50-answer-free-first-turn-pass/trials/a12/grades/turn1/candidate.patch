@@ -319,6 +319,31 @@ To safe_duration_cast(std::chrono::duration<FromRep, FromPeriod> from,
 // Usage: f FMT_NOMACRO()
 #define FMT_NOMACRO
 
+namespace fmt {
+
+template <typename To, typename From,
+          FMT_ENABLE_IF(std::is_floating_point<typename From::rep>::value ==
+                        std::is_floating_point<typename To::rep>::value)>
+To duration_cast_or_error(const From& from) {
+  int ec = 0;
+#if FMT_SAFE_DURATION_CAST
+  To to = safe_duration_cast::safe_duration_cast<To>(from, ec);
+  if (ec) FMT_THROW(format_error("cannot format duration"));
+#else
+  To to = std::chrono::duration_cast<To>(from);
+#endif
+  return to;
+}
+
+template <typename To, typename From,
+          FMT_ENABLE_IF(std::is_floating_point<typename From::rep>::value !=
+                        std::is_floating_point<typename To::rep>::value)>
+To duration_cast_or_error(const From& from) {
+  return std::chrono::duration_cast<To>(from);
+}
+
+}  // namespace fmt
