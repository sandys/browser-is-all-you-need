                fmt::safe_duration_cast::safe_duration_cast<seconds>(
                    std::chrono::duration_cast<seconds>(duration), ec);
            if (ec) FMT_THROW(format_error("cannot format duration"));
            return static_cast<std::time_t>(converted.count());
#else
            auto converted = std::chrono::duration_cast<seconds>(duration);
            return static_cast<std::time_t>(converted.count());
#endif
        }
        }
