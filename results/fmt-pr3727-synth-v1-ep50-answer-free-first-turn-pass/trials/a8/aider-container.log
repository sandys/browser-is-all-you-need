        namespace detail {
        template <typename Duration>
        std::time_t to_time_t(Duration duration) {
            using rep = typename Duration::rep;
            using seconds = std::chrono::seconds;
            if (detail::const_check(
                    std::is_floating_point<rep>::value ||
                    !std::is_integral<rep>::value)) {
                // Cast to seconds then to time_t
                auto converted = std::chrono::duration_cast<seconds>(duration);
                return static_cast<std::time_t>(converted.count());
