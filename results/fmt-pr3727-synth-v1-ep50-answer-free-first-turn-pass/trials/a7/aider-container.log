template <typename Duration>
std::time_t to_time_t(std::chrono::time_point<std::chrono::system_clock, 
Duration> time_point) {
    using namespace std::chrono;
    using rep = typename Duration::rep;
    using seconds = duration<rep, seconds::period>;
    using system_duration = typename time_point::duration;

    system_duration d = time_point.time_since_epoch();
    if (!is_convertible<system_duration, seconds>::value) {
        d = duration_cast<seconds>(d);
    }
    rep count = d.count();
    if (std::is_signed<rep>::value) {
        if (count > detail::max_value<std::time_t>() || count < 
detail::min_value<std::time_t>()) {
            FMT_THROW(format_error("cannot format duration"));
        }
    } else if (count > detail::max_value<std::time_t>()) {
        FMT_THROW(format_error("cannot format duration"));
    }
    return static_cast<std::time_t>(count);
}
