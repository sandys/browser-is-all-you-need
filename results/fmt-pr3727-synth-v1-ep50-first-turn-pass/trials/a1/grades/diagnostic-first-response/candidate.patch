+// Helper for fmt_duration_cast that avoids code duplication.
+template <typename To, typename From,
+          bool Enabled = is_same_arithmetic_type<typename From::rep,
+                                                 typename To::rep>::value>
+To fmt_duration_cast(std::chrono::duration<From> from) {
+  if (Enabled && FMT_SAFE_DURATION_CAST) {
+    int ec;
+    To to = safe_duration_cast::safe_duration_cast<To>(from, ec);
+    if (ec) FMT_THROW(format_error("cannot format duration"));
+    return to;
+  }
+  return std::chrono::duration_cast<To>(from);
+}
+
+template <typename To, typename From>
+To fmt_duration_cast(std::chrono::duration<From> from) {
+  return std::chrono::duration_cast<To>(from);
+}
+
+template <typename Duration>
+std::time_t to_time_t(std::chrono::time_point<std::chrono::system_clock, Duration> time_point) {
+  using duration = typename Duration::rep;
+  using seconds = std::chrono::duration<std::time_t>;
+  auto duration_since_epoch = time_point.time_since_epoch();
+  auto seconds = fmt_duration_cast<seconds>(duration_since_epoch);
+  return seconds.count();
+}
